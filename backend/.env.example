PORT=3000
NODE_ENV=development
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_CONNECT_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated HTTP(S) origins; empty denies cross-origin browser access.
CORS_ORIGINS=
CORS_CREDENTIALS=false
JSON_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

DATABASE_URL="postgresql://looply:your_password@localhost:5435/looply_dev?schema=public"
TEST_DATABASE_URL="postgresql://looply:your_password@localhost:5435/looply_test?schema=public"
