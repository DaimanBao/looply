PORT=3000
NODE_ENV=development
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_CONNECT_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Origin HTTP(S) phân cách bằng dấu phẩy; để trống sẽ từ chối truy cập trình duyệt khác origin.
CORS_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true
JSON_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

DATABASE_URL="postgresql://looply:your_password@localhost:5435/looply_dev?schema=public"
TEST_DATABASE_URL="postgresql://looply:your_password@localhost:5435/looply_test?schema=public"

# Sinh secret độc lập bằng node:crypto randomBytes(48).toString('base64url'). Không commit giá trị thật.
AUTH_JWT_SECRET=
AUTH_OTP_PEPPER=
AUTH_ISSUER=looply
AUTH_IP_LIMIT=60
AUTH_IP_WINDOW_SECONDS=60
AUTH_PASSWORD_LIMIT=10
AUTH_PASSWORD_WINDOW_SECONDS=900
AUTH_REAUTH_LIMIT=5
AUTH_REAUTH_WINDOW_SECONDS=900
AUTH_ALLOWED_ORIGINS=http://localhost:4200
GOOGLE_CLIENT_ID=
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/15
SMS_PROVIDER=fake
EMAIL_PROVIDER=fake
# Gateway thật nhận POST { destination, code, expiresIn } qua HTTPS có xác thực.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=
# Công cụ CLI kiểm tra OTP tùy chọn, riêng, chỉ loopback. Không bật trong production.
DEV_OTP_INSPECTOR_ENABLED=false
DEV_OTP_INSPECTOR_PORT=3101
DEV_OTP_INSPECTOR_KEY=
MEDIA_PROVIDER=local
MEDIA_LOCAL_DIRECTORY=.local-media
# Chuẩn bị bằng node scripts/setup-video-tools.mjs từ repository root.
# Đặt đường dẫn executable từ .video-tools/video.env; không công bố staging thành nội dung tĩnh.
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_VIDEO_BINARY_VERSION=n8.1.3-35-gf1acb0a266
# Để trống/không đặt sẽ dùng thư mục riêng looply-private-staging trong thư mục tạm hệ điều hành.
# MEDIA_STAGING_DIRECTORY=
MEDIA_VIDEO_TIMEOUT_MS=60000
MEDIA_UPLOAD_TIMEOUT_MS=120000
MEDIA_UPLOAD_CONCURRENCY=2
# Production yêu cầu s3 và gateway SMS/email thật; từ chối provider local/fake.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
