PORT=3000
NODE_ENV=development
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_CONNECT_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated HTTP(S) origins; empty denies cross-origin browser access.
CORS_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true
JSON_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

DATABASE_URL="postgresql://looply:your_password@localhost:5435/looply_dev?schema=public"
TEST_DATABASE_URL="postgresql://looply:your_password@localhost:5435/looply_test?schema=public"

# Generate independent secrets with node:crypto randomBytes(48).toString('base64url'). Never commit real values.
AUTH_JWT_SECRET=
AUTH_OTP_PEPPER=
AUTH_ISSUER=looply
AUTH_IP_LIMIT=60
AUTH_IP_WINDOW_SECONDS=60
AUTH_PASSWORD_LIMIT=10
AUTH_PASSWORD_WINDOW_SECONDS=900
AUTH_REAUTH_LIMIT=5
AUTH_REAUTH_WINDOW_SECONDS=900
AUTH_ALLOWED_ORIGINS=http://localhost:4200
GOOGLE_CLIENT_ID=
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/15
SMS_PROVIDER=fake
EMAIL_PROVIDER=fake
# Real gateways accept POST { destination, code, expiresIn } over authenticated HTTPS.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=
# Optional, separate loopback-only OTP CLI inspector. Never enable in production.
DEV_OTP_INSPECTOR_ENABLED=false
DEV_OTP_INSPECTOR_PORT=3101
DEV_OTP_INSPECTOR_KEY=
MEDIA_PROVIDER=local
MEDIA_LOCAL_DIRECTORY=.local-media
# Provision with node scripts/setup-video-tools.mjs from the repository root.
# Set executable paths from .video-tools/video.env; never expose staging as static content.
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_VIDEO_BINARY_VERSION=n8.1.3-35-gf1acb0a266
# Empty/not set uses a private looply-private-staging directory under the OS temp directory.
# MEDIA_STAGING_DIRECTORY=
MEDIA_VIDEO_TIMEOUT_MS=60000
MEDIA_UPLOAD_TIMEOUT_MS=120000
MEDIA_UPLOAD_CONCURRENCY=2
# Production requires s3 and real SMS/email gateways; local/fake providers are rejected.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
